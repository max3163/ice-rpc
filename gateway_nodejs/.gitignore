# Rust build artifacts
target/

# Node.js dependencies
node_modules/

# napi-rs build outputs: regenerated by `npm run build`
index.js
index.d.ts
*.node

# iceoryx2 global configuration, written at runtime next to the current
# directory by `ice_rpc::gen::setup_iceoryx2_global_config()`; it embeds a
# machine-specific root-path and must never be committed.
config/iceoryx2.toml

# `package-lock.json` is deliberately NOT ignored: `cargo release` rewrites its
# version and CI needs it to install the addon's build tooling reproducibly
# (`npm ci` fails outright without it).
